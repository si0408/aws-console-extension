{
  "name": "AWSコンソール拡張機能",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "AWSコンソールでアカウント名を表示させる拡張機能です。",
  "permissions": ["cookies", "activeTab"],
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": ["https://*.console.aws.amazon.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
